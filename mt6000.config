# ==============================================================================
# GL-MT6000 (Flint 2) Custom OpenWrt Firmware Configuration
# Baseline: pesa1234/MT6000_cust_build (config.buildinfo)
#
# Legend:
#   [PESA-BASE]     : Inherited directly from pesa1234 baseline
#   [PESA-TUNED]    : Compiler, toolchain, or subsystem tuning over pesa1234
#   [PESA-PROMOTED] : Built directly into squashfs (=y) instead of external module (=m)
#   [CUSTOM-ADDED]  : Brand new feature, daemon, or tool added to this firmware
#   [CUSTOM-REMOVED]: Explicitly disabled / replaced upstream package
# ==============================================================================

# ==============================================================================
# 1. Target & Hardware Platform [PESA-BASE]
# ==============================================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt6000=y
CONFIG_TARGET_OPTIONS=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_IMAGEOPT=y
CONFIG_JSON_CYCLONEDX_SBOM=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="OpenWrt"
CONFIG_VERSION_CODE=""
CONFIG_VERSION_CODE_FILENAMES=y
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_NUMBER=""
CONFIG_VERSION_PRODUCT=""
CONFIG_VERSION_HWREV=""
CONFIG_VERSION_MANUFACTURER=""
CONFIG_VERSION_MANUFACTURER_URL=""
CONFIG_VERSION_BUG_URL=""
CONFIG_VERSION_HOME_URL=""
CONFIG_VERSION_SUPPORT_URL=""
CONFIG_VERSION_FIRMWARE_URL=""
CONFIG_VERSION_REPO="https://raw.githubusercontent.com/pesa1234/MT6000_cust_build/refs/heads/main"
CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_TESTING_KERNEL=y
CONFIG_LINUX_6_18=y

# ==============================================================================
# 2. Compiler, Toolchain & CPU Optimization
# ==============================================================================
# [PESA-TUNED] CPU optimization: enables ARMv8 CRC32 and Crypto instructions on Cortex-A53
# (pesa1234 baseline used generic "-O2 -pipe -mcpu=cortex-a53")
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"

# [CUSTOM-ADDED] Advanced toolchain features (Link-Time Optimization, Dead Code Elimination, LLVM)
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_LLVM_BUILD=y
CONFIG_NEED_BPF_TOOLCHAIN=y

# [CUSTOM-ADDED] Go toolchain configuration: use host Go instead of incompatible Go 1.4 bootstrap
# CONFIG_GOLANG_BUILD_BOOTSTRAP is not set
CONFIG_GOLANG_EXTERNAL_BOOTSTRAP_ROOT="/usr/lib/go"

# ==============================================================================
# 3. Security & Binary Hardening [CUSTOM-ADDED]
# ==============================================================================
# Full Position Independent Executables (ASLR PIE)
# CONFIG_BUSYBOX_CONFIG_INCLUDE_SUSv2 is not set
CONFIG_BUSYBOX_CONFIG_PIE=y
CONFIG_BUSYBOX_DEFAULT_PIE=y
# CONFIG_PKG_ASLR_PIE_REGULAR is not set
CONFIG_PKG_ASLR_PIE_ALL=y

# Strong Stack Protector (Kernel + Userland)
# CONFIG_PKG_CC_STACKPROTECTOR_REGULAR is not set
CONFIG_PKG_CC_STACKPROTECTOR_STRONG=y
CONFIG_KERNEL_STACKPROTECTOR_STRONG=y
# CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR is not set
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y

# Buffer Overflow Protection (Fortify Source 2)
# CONFIG_PKG_FORTIFY_SOURCE_1 is not set
CONFIG_PKG_FORTIFY_SOURCE_2=y

# Kernel Swap support enabled for memory expansion
CONFIG_KERNEL_SWAP=y

# [CUSTOM-REMOVED] Strip kernel debugging symbols and core dumps for compact flash size
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_ELF_CORE is not set
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set

# ==============================================================================
# 4. Core Subsystem Replacements & Overrides
# ==============================================================================

## SSH Server: OpenSSH replaces Dropbear
# [CUSTOM-REMOVED] Lightweight Dropbear disabled
# CONFIG_PACKAGE_dropbear is not set
# [CUSTOM-ADDED] Full OpenSSH server, client, SFTP server, and tools
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssh-keygen=y
CONFIG_PACKAGE_openssh-moduli=y

## SSL & Cryptography: Unified OpenSSL 3 Stack
# [CUSTOM-REMOVED] mbedTLS eliminated in favor of single consolidated OpenSSL stack
# CONFIG_PACKAGE_libmbedtls is not set
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_LUA_ECO_MBEDTLS is not set
# [CUSTOM-REMOVED] Insecure / deprecated OpenSSL 1.1 algorithms disabled
CONFIG_OPENSSL_NO_DEPRECATED=y
# CONFIG_OPENSSL_WITH_DEPRECATED is not set
# CONFIG_PACKAGE_libopenssl-legacy is not set
# [CUSTOM-ADDED / PESA-TUNED] OpenSSL integrations
CONFIG_LUA_ECO_OPENSSL=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_HTTP_AUTH=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_openssl-util=y
# [PESA-BASE] OpenSSL hardware engine & algorithm acceleration
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_ENGINE_BUILTIN=y
CONFIG_OPENSSL_ENGINE_BUILTIN_DEVCRYPTO=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_OPENSSL_WITH_CHACHA_POLY1305=y
CONFIG_OPENSSL_WITH_CMS=y
CONFIG_OPENSSL_WITH_ERROR_MESSAGES=y
CONFIG_OPENSSL_WITH_IDEA=y
CONFIG_OPENSSL_WITH_MDC2=y
CONFIG_OPENSSL_WITH_PSK=y
CONFIG_OPENSSL_WITH_SEED=y
CONFIG_OPENSSL_WITH_SRP=y
CONFIG_OPENSSL_WITH_TLS13=y
CONFIG_OPENSSL_WITH_WHIRLPOOL=y

## DNS & DHCP Subsystem: Unified dnsmasq-full
# [PESA-BASE / PESA-TUNED] Comprehensive dnsmasq-full with DHCPv6 enabled
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

## Shell & History
# [PESA-TUNED] Save interactive command history in BusyBox
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_SAVEHISTORY=y

## Wireless Boot & Performance Scripts
# [PESA-TUNED] Fast WiFi startup UCODE scripts and runtime plugins
CONFIG_WIFI_SCRIPTS_UCODE=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-uloop=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-socket=y

## Airtime Fairness & DebugFS Menu
# [CUSTOM-ADDED] Needed for Airtime Fairness (ATF) in LuCI -> Network -> Wireless
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_PACKAGE_MAC80211_DEBUGFS=y

# ==============================================================================
# 5. Base OpenWrt System & Core Infrastructure [PESA-BASE]
# ==============================================================================
# BusyBox core options
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_CROND_SPECIAL_TIMES=y
CONFIG_BUSYBOX_CONFIG_FEATURE_PIDOF_SINGLE=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SYSLOG_INFO=y
